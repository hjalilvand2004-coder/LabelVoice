# نمونه تنظیمات بدون اطلاعات محرمانه — کپی به .env و پر کردن مقادیر واقعی
# همه کلیدها از متغیر محیط یا همین فایل خوانده می‌شوند؛ هرگز کلید واقعی را کامیت نکنید.

# موتور OCR: tesseract | easyocr | surya | auto  (surya: موتور سوم اختیاری v2.2.0 — pip install -r requirements-surya.txt)
LBR_OCR_PROVIDER=tesseract
# زبان‌های OCR (نیازمند fas.traineddata برای فارسی)
LBR_OCR_LANGUAGES=fas+eng

# محدودیت‌های تصویر
LBR_MAX_FILE_MB=10
LBR_MAX_PIXELS=30000000

# TTS فارسی: edge | gtts | none
LBR_TTS_PROVIDER=edge
LBR_TTS_VOICE=fa-IR-FaridNeural
LBR_TTS_RATE=+0%

# LLM اختیاری — پیش‌فرض خاموش؛ مسیر اصلی بدون LLM کار می‌کند
LBR_LLM_ENABLED=false
LBR_LLM_BASE_URL=
LBR_LLM_MODEL=
LBR_LLM_API_KEY=
